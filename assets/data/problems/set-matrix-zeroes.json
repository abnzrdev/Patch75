  "description": "Given an `m x n` integer matrix, if an element is `0`, set its entire row and column to `0`.\n\nReturn the matrix after applying this operation.",
  "examples": [
    {
      "input": "matrix = [[1,1,1],[1,0,1],[1,1,1]]",
      "output": "[[1,0,1],[0,0,0],[1,0,1]]"
    },
    {
      "input": "matrix = [[0,1,2,0],[3,4,5,2],[1,3,1,5]]",
      "output": "[[0,0,0,0],[0,4,5,0],[0,3,1,0]]"
    }
  ],
  "constraints": [
    "`m == matrix.length`",
    "`n == matrix[i].length`",
    "`1 <= m, n <= 200`",
    "`-2^31 <= matrix[i][j] <= 2^31 - 1`"
