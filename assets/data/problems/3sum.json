  "description": "Given an integer array `nums`, return all the triplets `[nums[i], nums[j], nums[k]]` such that `i != j`, `i != k` and `j != k` and `nums[i] + nums[j] + nums[k] == 0`.",
  "examples": [
    {
      "input": "nums = [-1,0,1,2,-1,-4]",
      "output": "[[-1,-1,2],[-1,0,1]]"
    },
    {
      "input": "nums = [0,1,1]",
      "output": "[]"
    },
    {
      "input": "nums = [0,0,0]",
      "output": "[[0,0,0]]"
    }
  ],
  "constraints": [
    "3 ≤ nums.length ≤ 3000",
    "-10^5 ≤ nums[i] ≤ 10^5"
  ],
